{
  "name": "worldstreams-ai-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production node server.mjs",
    "generate:streams": "node --env-file=.env scripts/generate-omni-clips.mjs",
    "test": "vitest run && node scripts/verify-security.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "check": "npm run test && npm run build && npm run test:smoke"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google/genai": "^1.30.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.14",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^4.1.11"
  }
}
